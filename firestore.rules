rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Authenticated Admin Check
    function isAdmin() {
      return request.auth != null;
    }

    // 1. Events collection: Public write-only with payload validation
    match /events/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['visitorId', 'sessionId', 'variant', 'timestamp', 'event'])
                    && request.resource.data.visitorId is string
                    && request.resource.data.variant in ['a', 'b', 'c']
                    && request.resource.size() < 10000;
      allow read, update, delete: if isAdmin();
    }

    // 2. Launch Sign-ups collection: Public write-only
    match /signups/{signupId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'timestamp'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 254;
      allow read, update, delete: if isAdmin();
    }

    // 3. Chutney Requests collection: Public write-only
    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for unauthenticated public
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
