rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Pre-launch demand testing events:
    // Anyone (anonymous visitors) can write/create events to test demand.
    // Reading, modifying, or deleting events is strictly forbidden for the public.
    match /events/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['event', 'timestamp', 'visitorId', 'variant', 'source'])
                    && request.resource.data.visitorId is string
                    && request.resource.data.variant in ['A', 'B', 'C'];
      allow read, update, delete: if false;
    }

    // Launch waitlist registrations:
    // Anyone can submit their email/phone for early launch updates.
    // Reading or scraping the waitlist is forbidden for public access.
    match /waitlist/{waitlistId} {
      allow create: if request.resource.data.keys().hasAny(['email', 'phone', 'pincode']);
      allow read, update, delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
