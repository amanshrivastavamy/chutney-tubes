# Chutney Tubes Pre-Launch Environment Configuration

# Firebase Project Configuration (Optional for local testing; required for live production Firestore sync)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Admin Dashboard Password (used to unlock /admin metrics and CSV export)
ADMIN_PASSWORD=chutney2026

# Server Port
PORT=3000
